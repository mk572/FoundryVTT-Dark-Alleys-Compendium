    "feats": {
      "0": {
        "description": {
          "type": "String",
          "value": "<p><span id=\"docs-internal-guid-ebb45d9e-7fff-20b7-3026-3a751d0a1424\">You suck the life out of your surroundings to sustain yourself. When you make a recovery roll to heal, and a die comes up as the maximum, deal negative energy damage equal to that die to each enemy engaged with you</span></p>"
        },
        "isActive": {
          "type": "Boolean",
          "value": false
        },
        "tier": {
          "type": "String",
          "value": "adventurer"
        },
